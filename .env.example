# ──────────────────────────────────────────────────
# EPMS — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────

# Neon Postgres (pooled connection for Prisma Client)
DATABASE_URL=

# Neon Postgres (direct connection for migrations)
DIRECT_URL=

# JWT signing secret (generate with: openssl rand -base64 64)
JWT_SECRET=

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@epms.27mediaagency.com

# ImageKit.io image storage
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Root domain for subdomain routing
NEXT_PUBLIC_ROOT_DOMAIN=27mediaagency.com

# Super admin seed credentials (first-login forced password change)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=
